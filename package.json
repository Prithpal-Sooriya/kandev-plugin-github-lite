{
  "name": "kandev-plugin-github-lite",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test:recipes": "vitest run recipes/source-control/ui tests",
    "typecheck:recipes": "tsc --project tsconfig.recipes.json --noEmit",
    "bundle:ui": "esbuild ui/register.ts --bundle --format=esm --target=es2022 --outfile=ui/bundle.js --legal-comments=none",
    "build:ui": "npm run typecheck:recipes && npm run bundle:ui",
    "test:ui": "vitest run tests"
  },
  "devDependencies": {
    "@kandev/plugin-sdk": "file:../kandev-sdk/apps/packages/plugin-sdk",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "nanoid": "5.1.16"
  },
  "version": "0.1.3"
}